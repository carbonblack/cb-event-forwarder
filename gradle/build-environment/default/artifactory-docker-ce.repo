[artifactory-docker-ce-stable]
name=Artifactory Docker CE Stable - $basearch
baseurl=https://{ARTIFACTORY_USERNAME}:{ARTIFACTORY_API_KEY}@{ARTIFACTORY_BASE_URL}/artifactory/gateway-centos-docker-vr/$releasever/$basearch/stable
enabled=1
gpgcheck=0

[artifactory-docker-ce-stable-debuginfo]
name=Artifactory Docker CE Stable - Debuginfo $basearch
baseurl=https://{ARTIFACTORY_USERNAME}:{ARTIFACTORY_API_KEY}@{ARTIFACTORY_BASE_URL}/artifactory/gateway-centos-docker-vr/$releasever/debug-$basearch/stable
enabled=0
gpgcheck=0

[artifactory-docker-ce-stable-source]
name=Artifactory Docker CE Stable - Sources
baseurl=https://{ARTIFACTORY_USERNAME}:{ARTIFACTORY_API_KEY}@{ARTIFACTORY_BASE_URL}/artifactory/gateway-centos-docker-vr/$releasever/source/stable
enabled=0
gpgcheck=0

